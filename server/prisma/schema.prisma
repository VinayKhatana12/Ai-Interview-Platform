generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// Account roles for the platform. Candidates take interviews;
// interviewers/admins manage them (admin tooling arrives in a later milestone).
enum Role {
  CANDIDATE
  INTERVIEWER
  ADMIN

  @@map("user_role")
}

// Question/interview difficulty. Shared by Interview and Question so the
// AI generator's requested difficulty and each question's own level stay comparable.
enum Difficulty {
  EASY
  MEDIUM
  HARD

  @@map("difficulty")
}

// Interview delivery mode. The candidate picks this at creation; the
// session opens in the chosen mode (voice answers are transcribed).
enum InterviewMode {
  TEXT
  VOICE

  @@map("interview_mode")
}

// What the interview drills: technical questions, behavioral (STAR-style),
// or a mix. The generator and fixture read this.
enum InterviewType {
  TECHNICAL
  BEHAVIORAL
  MIXED

  @@map("interview_type")
}

// Lifecycle of an interview. PENDING -> IN_PROGRESS -> COMPLETED.
enum InterviewStatus {
  PENDING
  IN_PROGRESS
  COMPLETED

  @@map("interview_status")
}

model User {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  email            String   @unique
  passwordHash     String   @map("password_hash")
  role             Role     @default(CANDIDATE)
  // Target seniority set on the profile; mirrors the interview form's options.
  experienceLevel  String?  @map("experience_level")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  interviews Interview[]

  @@map("users")
}

model Interview {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  roleTitle       String          @map("role_title")
  experienceLevel String          @map("experience_level")
  difficulty      Difficulty
  interviewType   InterviewType   @default(TECHNICAL) @map("interview_type")
  mode            InterviewMode   @default(TEXT)
  status          InterviewStatus @default(PENDING)
  durationMinutes Int             @map("duration_minutes")
  topics          String[]        @default([])
  questionCount   Int             @map("question_count")
  createdAt       DateTime        @default(now()) @map("created_at")
  startedAt       DateTime?       @map("started_at")
  completedAt     DateTime?       @map("completed_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions Question[]
  answers   Answer[]

  // Serves "list this user's interviews, newest first" and the FK lookups.
  @@index([userId, createdAt])
  @@map("interviews")
}

model Question {
  id            String     @id @default(uuid()) @db.Uuid
  interviewId   String     @map("interview_id") @db.Uuid
  text          String
  topic         String
  difficulty    Difficulty
  questionOrder Int        @map("question_order")
  questionType  String     @map("question_type")
  createdAt     DateTime   @default(now()) @map("created_at")

  // Adaptive follow-ups: a follow-up copies its original question's
  // questionOrder (so it sorts directly after it) and carries
  // followUpIndex 1..N; planned questions keep followUpIndex 0.
  parentQuestionId String?    @map("parent_question_id") @db.Uuid
  parentQuestion   Question?  @relation("FollowUpChain", fields: [parentQuestionId], references: [id], onDelete: Cascade)
  followUps        Question[] @relation("FollowUpChain")
  isFollowUp       Boolean    @default(false) @map("is_follow_up")
  followUpIndex    Int        @default(0) @map("follow_up_index")

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  answer    Answer?

  // One planned question per position; follow-ups share the parent's order
  // but are distinguished by followUpIndex (also backs the FK index).
  @@unique([interviewId, questionOrder, followUpIndex])
  // One follow-up per depth per original question — DB-backed idempotency
  // for retried follow-up requests.
  @@unique([parentQuestionId, followUpIndex])
  @@map("questions")
}

model Answer {
  id               String   @id @default(uuid()) @db.Uuid
  questionId       String   @unique @map("question_id") @db.Uuid
  interviewId      String   @map("interview_id") @db.Uuid
  responseText     String   @map("response_text")
  submittedAt      DateTime @default(now()) @map("submitted_at")
  timeTakenSeconds Int      @map("time_taken_seconds")

  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  interview  Interview   @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  evaluation Evaluation?

  // One answer per question; backs the one-to-one relation and the FK lookups.
  // Separate index for interview-scoped answer lists (e.g. results pages).
  @@index([interviewId])
  @@map("answers")
}

// Rubric verdict from the evaluation provider, kept as its own enum so the
// score (a number) and the verdict (a category) stay honest together.
enum EvaluationCorrectness {
  CORRECT
  PARTIALLY_CORRECT
  INCORRECT

  @@map("evaluation_correctness")
}

model Evaluation {
  id           String   @id @default(uuid()) @db.Uuid
  answerId     String   @unique @map("answer_id") @db.Uuid
  // 0–100, scale enforced in the service layer.
  score        Float
  correctness  EvaluationCorrectness @default(PARTIALLY_CORRECT)
  feedback     String
  // Flexible lists from the LLM (e.g. ["Explained X clearly", ...]);
  // core scoring fields above stay typed.
  strengths    Json
  improvements Json
  modelAnswer  String   @map("model_answer")
  createdAt    DateTime @default(now()) @map("created_at")

  answer Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@map("evaluations")
}
