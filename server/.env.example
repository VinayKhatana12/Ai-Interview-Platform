# PostgreSQL connection used by Prisma (CLI via prisma7.config.ts) and the API server.
# Copy this file to `.env` and replace YOUR_PASSWORD_HERE with the postgres
# password you set during PostgreSQL installation. Never commit the real .env.

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/ai_interview?schema=public"

# Signing key for session JWTs. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_GENERATED_SECRET

# AI provider (Google Gemini). Without AI_API_KEY the app uses clearly-labeled
# development fixtures. Get a key: https://aistudio.google.com/apikey
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-flash-lite-latest
# AI_TIMEOUT_MS=30000
