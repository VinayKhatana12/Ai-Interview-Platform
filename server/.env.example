# PostgreSQL connection used by Prisma (CLI via prisma7.config.ts) and the API server.
# Copy this file to `.env` and replace YOUR_PASSWORD_HERE with the postgres
# password you set during PostgreSQL installation. Never commit the real .env.

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/ai_interview?schema=public"

# Signing key for session JWTs. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_GENERATED_SECRET

# AI provider (Google Gemini). Without AI_API_KEY the app uses clearly-labeled
# development fixtures. Get a key: https://aistudio.google.com/apikey
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-flash-lite-latest
# AI_TIMEOUT_MS=30000

# Speech-to-text for voice answers. PRIMARY: your existing Gemini key
# (AI_API_KEY above) — free tier, model gemini-3.5-transcribe. Optional
# alternative: an OpenAI key, used only when AI_API_KEY is absent.
# STT_MODEL=gemini-3.5-transcribe
OPENAI_API_KEY=

# Text-to-speech for questions (same provider selector as STT).
# PRIMARY: Gemini (free) — model gemini-3.8-flash-tts, voice Kore.
#   TTS_GEMINI_MODEL=gemini-3.8-flash-tts
#   TTS_GEMINI_VOICE=Kore
# ALTERNATIVE: OpenAI gpt-4o-mini-tts, voice marin (deprecated by OpenAI
# on 2027-01-06 — TTS_MODEL exists so the swap is a config change).
#   TTS_MODEL=gpt-4o-mini-tts
#   TTS_VOICE=marin
